# homenative: Home Native (the io.github.tiper.homenative app) as the TV's system Home.
# Bind-mounts its binary over LG's /usr/bin/com.webos.app.home, so SAM, the Home key and power-on
# start it, and covers Home's CRIU checkpoint with an empty read-only directory, so it is always
# cold-started (CRIU can neither restore LG's snapshot nor save one of ours). Nothing on the
# read-only rootfs is changed.
# Undo: delete this file and reboot. Off without deleting: touch /var/lib/homenative/disabled, reboot.
# Without the app installed this does nothing and LG's Home runs.

NH=/media/developer/apps/usr/palm/applications/io.github.tiper.homenative/homenative
H=/usr/bin/com.webos.app.home
CP=/mnt/lg/cmn_data/checkpoint/com.webos.app.home
E=/tmp/homenative-checkpoint

[ -f /var/lib/homenative/disabled ] && exit 0
[ -x "$NH" ] || exit 0

ours=$(md5sum < "$NH")
log() { echo "$(cut -d" " -f1 /proc/uptime) $*" >> /tmp/homenative-hook.log; }
# This build kept crashing and stepped aside (see "safety net" in src/home.c): LG's Home stays,
# until a different build is installed.
if [ "$(cat /var/lib/homenative/failed 2>/dev/null)" = "$ours" ]; then
  log "this build failed: leaving LG's Home"
  exit 0
fi

grep -q " $H " /proc/mounts || mount --bind "$NH" "$H" || exit 0
mkdir -p $E
if ! grep " $CP " /proc/mounts | tail -1 | grep -q "^tmpfs .* ro,"; then
  mount --bind $E $CP && mount -o remount,bind,ro $CP
fi

# Home is already running: LG's, resumed by the snapshot boot ~14 s in, before any of these
# hooks. Swap it for ours right away. It is brought to the front only if Home was there, so live
# TV or HDMI is never interrupted; otherwise ours is preloaded hidden (SAM would only start Home
# itself at ~70 s). A second look a little later catches anything that brought LG's back.
log "mounted"
foreground() {
  luna-send -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{}' 2>/dev/null |
    sed -n 's/.*"appId": *"\([^"]*\)".*/\1/p'
}
swap_if_lg() {
  lg=""
  for P in $(pidof com.webos.app.home); do
    [ "$(md5sum < /proc/$P/exe 2>/dev/null)" = "$ours" ] || lg="$lg $P"
  done
  [ -n "$lg" ] || return 0
  fg=$(foreground)
  log "killing LG Home$lg (foreground: $fg)"
  kill -9 $lg
  sleep 1
  if [ -z "$fg" ] || [ "$fg" = "com.webos.app.home" ]; then
    [ -z "$(pidof com.webos.app.home)" ] &&
      luna-send -n 1 luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' >/dev/null 2>&1
  fi
}
# Start ours in the background, as SAM itself does later in boot, so Home is ready at once.
preload() {
  [ -z "$(pidof com.webos.app.home)" ] || return 0
  log "preloading"
  luna-send -n 1 luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home","preload":"full"}' >/dev/null 2>&1
}
(
  i=0
  while [ -z "$(pidof com.webos.app.home)" ] && [ $i -lt 5 ]; do sleep 1; i=$((i + 1)); done
  swap_if_lg
  preload
  sleep 20
  swap_if_lg
  preload
) &

# SAM doesn't restart a Home that dies behind another app or in standby, and waking the TV doesn't
# either, so Home stays gone until someone presses the Home key and waits for a cold start. Two
# looks a little apart, so this doesn't race SAM, and it ends once the mounts are lifted. A preload
# takes the front from the app on screen, so that app gets it back.
W=/tmp/homenative-watch
kill "$(cat $W 2>/dev/null)" 2>/dev/null
(
  gone=0
  while sleep 30 && grep -q " $H " /proc/mounts; do
    if [ -n "$(pidof com.webos.app.home)" ]; then gone=0; continue; fi
    gone=$((gone + 1))
    [ $gone -lt 2 ] && continue
    gone=0
    fg=$(foreground)
    preload
    [ -n "$fg" ] && [ "$fg" != "com.webos.app.home" ] || continue
    end=$(($(date +%s) + 4))
    while [ "$(date +%s)" -lt "$end" ]; do
      [ "$(foreground)" = "com.webos.app.home" ] || continue
      log "giving the front back to $fg"
      luna-send -n 1 luna://com.webos.applicationManager/launch "{\"id\":\"$fg\"}" >/dev/null 2>&1
      break
    done
  done
) </dev/null >/dev/null 2>&1 &
echo $! > $W
exit 0
